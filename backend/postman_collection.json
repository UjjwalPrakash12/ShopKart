    {
      "name": "Products Catalog (Lab 03)",
      "item": [
        {
          "name": "1. Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"description\": \"RGB mechanical keyboard with blue switches.\",\n  \"price\": 2999,\n  \"category\": \"Electronics\",\n  \"image\": \"https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=800&q=80\",\n  \"stock\": 10\n}"
            },
            "url": {
              "raw": "http://localhost:5000/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["products"]
            }
          }
        },
        {
          "name": "2. Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["products"]
            }
          }
        },
        {
          "name": "3. Search Products by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/products?search=keyboard",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["products"],
              "query": [
                { "key": "search", "value": "keyboard" }
              ]
            }
          }
        },
        {
          "name": "4. Filter Products by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/products?category=Electronics",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["products"],
              "query": [
                { "key": "category", "value": "Electronics" }
              ]
            }
          }
        },
        {
          "name": "5. Search & Category Combined",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/products?search=keyboard&category=Electronics",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["products"],
              "query": [
                { "key": "search", "value": "keyboard" },
                { "key": "category", "value": "Electronics" }
              ]
            }
          }
        },
        {
          "name": "6. Sort by Price Ascending (Bonus +10)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/products?sort=price_asc",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["products"],
              "query": [
                { "key": "sort", "value": "price_asc" }
              ]
            }
          }
        },
        {
          "name": "7. Sort by Price Descending (Bonus +10)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/products?sort=price_desc",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["products"],
              "query": [
                { "key": "sort", "value": "price_desc" }
              ]
            }
          }
        },
        {
          "name": "8. Get Single Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/products/66d123abc456000000000001",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["products", "66d123abc456000000000001"]
            }
          }
        }
      ]
