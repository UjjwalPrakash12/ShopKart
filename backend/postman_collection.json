            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"john123\",\n  \"newPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/customers/change-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["customers", "change-password"]
            }
