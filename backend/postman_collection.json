{
  "info": {
    "name": "ShopKart API - Labs 01 to 03",
    "_postman_id": "shopkart-api-suite",
    "description": "Collection of APIs for ShopKart Customer Authentication & Product Catalog",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customer Auth",
      "item": [
        {
          "name": "1. Register Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@gmail.com\",\n  \"password\": \"john123\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/customers/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["customers", "register"]
            }
          }
        },
        {
          "name": "2. Login Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@gmail.com\",\n  \"password\": \"john123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/customers/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["customers", "login"]
            }
          }
        },
        {
          "name": "3. Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/customers/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["customers", "me"]
            }
          }
        },
        {
          "name": "4. Change Password (Bonus +10)",
          "request": {
